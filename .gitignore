# ==========================================
# NetGuard - Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
# (Never commit real credentials, API keys, or JWT secrets to GitHub)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!**/.env.example

# Local SQLite Databases & Runtime Storage
# (Prevent committing live databases, user accounts, audit trails, and journal files)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*
!backend/data/.gitkeep

# Build Outputs & Bundles
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & Coverage Outputs
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Temporary & Cache Directories
.cache/
.eslintcache
.temp/
.tmp/
scratch/
